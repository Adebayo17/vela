# hls_impl.tcl — Out-of-context implementation of the HLS CNN accelerator (Vivado)
#
# Synthesizes, places and routes the RTL generated by Vitis HLS
# (build/hls/cnn_proj/sol1/syn/verilog, top cnn_hw) on xc7z020clg400-1 with a
# 100 MHz clock on ap_clk, and writes to <out_dir>:
#   utilization.rpt   report_utilization after routing
#   timing.rpt        report_timing_summary after routing
#   summary.txt       "cnn_hw <WNS> <WHS> <WHS_IO>" (ns)
#
# Run separately from Vitis (which would otherwise stay in memory while it
# launches Vivado: see TN005 / journal, systemd-oomd incident of 2026-11-01).
#
# Usage (from build/, see `make hls-impl`):
#   vivado -mode batch -nojournal -nolog -source ../tools/hls_impl.tcl \
#          -tclargs <verilog_dir> <out_dir>
#
# Timing model as in tools/synth.tcl: inputs / outputs with a 0 ns delay
# relative to ap_clk; WHS measured between internal registers.

set part   xc7z020clg400-1
set period 10.000

set rtl_dir [file normalize [lindex $argv 0]]
set out_dir [file normalize [lindex $argv 1]]
file mkdir $out_dir

proc slack {paths} {
    if {[llength $paths] == 0} { return NA }
    return [get_property SLACK [lindex $paths 0]]
}

# The ROM / RAM initialization files are read with $readmemh("./<file>.dat"):
# run from the RTL directory so that Vivado finds them.
cd $rtl_dir

create_project -in_memory -part $part
read_verilog [glob [file join $rtl_dir *.v]]
synth_design -top cnn_hw -part $part -mode out_of_context

create_clock -period $period -name ap_clk [get_ports ap_clk]
set_input_delay  -clock ap_clk 0 [get_ports -filter {DIRECTION == IN && NAME != ap_clk}]
set_output_delay -clock ap_clk 0 [get_ports -filter {DIRECTION == OUT}]

opt_design
place_design
route_design

report_utilization    -file [file join $out_dir utilization.rpt]
report_timing_summary -file [file join $out_dir timing.rpt]

set wns    [slack [get_timing_paths -setup -max_paths 1]]
set regs   [all_registers]
set whs    [slack [get_timing_paths -hold -max_paths 1 -from $regs -to $regs]]
set whs_io [slack [get_timing_paths -hold -max_paths 1]]
set fh [open [file join $out_dir summary.txt] w]
puts $fh "cnn_hw $wns $whs $whs_io"
close $fh
puts "SUMMARY cnn_hw WNS=$wns WHS=$whs WHS_IO=$whs_io"
